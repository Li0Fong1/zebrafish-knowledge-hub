# 复制为 .env 后修改（测试包内通常已配好）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=zebrafish_db

WEB_HOST=127.0.0.1
WEB_PORT=8080
# 局域网/云服务器对外：改为 WEB_HOST=0.0.0.0
# 本机临时公网（无需改此项）：启动菜单 16 或 scripts\expose_internet.bat

# 便携包内 FAISS 索引路径（勿改，除非自行迁移）
FAISS_INDEX_DIR=./data/faiss_index

# ── 图集与演示文稿（Figure & Deck）──────────────────────────────
# 生成命令：python scripts\make_figures.py && python scripts\build_ppt.py
# 输出目录（图件 / PPT / 图注 / 审计报告）；留空 = 项目根 Figure/
FIG_OUTPUT_DIR=
# 图件输出分辨率
FIG_DPI=300
# 演示文稿语言：en | zh | both
FIG_DECK_LANG=both
FIG_DECK_EN_NAME=斑马鱼知识中枢_图集与图注.pptx
FIG_DECK_ZH_NAME=斑马鱼知识中枢_图集与图注_中文版.pptx
# 每图页关键要点条数上限（2-4）
FIG_DECK_POINTS=3
# 是否输出 Legend.md（中英对照图注文档）
FIG_EMIT_LEGEND_MD=1
# 权威快照 / 检索实测 新鲜度阈值（天）
FIG_SNAPSHOT_MAX_AGE_DAYS=14
FIG_PROBE_MAX_AGE_DAYS=30
FIG_SNAPSHOT_TIMEOUT_SEC=240
# 回归门禁：最少断言数 / 允许的审计差异数
FIG_VERIFY_MIN_ASSERTIONS=200
FIG_AUDIT_ALLOW_MISMATCH=0

# 回答长度与生成长度（字/ token，过小会截断文末参考文献）
LLM_MAX_NEW_TOKENS=4096
LLM_REASONING_MAX_TOKENS=4096
ANSWER_MAX_CHARS=8000
RAG_CONTEXT_MAX_CHARS=48000
LLM_API_TIMEOUT=150

# 回答模式：academic=数字严核 | balanced=短答先结论后因素（默认对标领域问答）
ANSWER_MODE=balanced

# 公网免令牌（已定方案）。临时隧道不要再自动打开访问闸门。
# WEB_ACCESS_TOKEN=  # 可留空；WEB_AUTH_REQUIRED=0 时不校验
# WEB_AUTH_REQUIRED=0
# WEB_STRICT=0
# WEB_ALLOW_UPLOAD=1
# WEB_RATE_LIMIT_CHAT=12
# WEB_RATE_LIMIT_TOOLS=30
# WEB_RATE_LIMIT_API=80
# WEB_RATE_LIMIT_UPLOAD=5
# WEB_AUTH_FAIL_MAX=25
# WEB_AUTH_BAN_SECONDS=900
# WEB_MAX_BODY_BYTES=600000
# WEB_UPLOAD_MAX_BYTES=5242880
# WEB_UPLOAD_MAX_TEXT_CHARS=500000
# WEB_UPLOAD_MAX_PDF_PAGES=120
# WEB_UPLOAD_MAX_FILES=300
# WEB_CORS_ORIGINS=
# 分权令牌（可选）：admin=WEB_ACCESS_TOKEN；只读/上传可单独发放
# WEB_TOKEN_READONLY=read-only-token-for-guests
# WEB_TOKEN_UPLOAD=upload-only-token
# 通信载荷 AES-GCM（/api/chat 请求/响应加密，密钥由令牌派生）
# WEB_PAYLOAD_ENCRYPT=1
# WEB_PAYLOAD_SALT=zfqa-payload-v1

# 大模型：local=仅本地 | api=仅云端 | hybrid=云端优先、失败回退本地 0.5B
LLM_MODE=hybrid
LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
LLM_API_MODEL=deepseek-chat
LLM_API_TIMEOUT=150
LLM_API_TEMPERATURE=0.3

# NCBI E-utilities（PubMed 文献采集，可选，无 Key 限速 3 req/s）
# NCBI_API_KEY=
# NCBI_EMAIL=your@email.com

# Clarivate Web of Science Starter API（机构订阅，可选）
# WOS_API_KEY=
# WOS_REQUEST_INTERVAL=1.0

# PubMedYes 文献检索（按篇：粗打分 500 篇 → 精细打分 100 篇 → 相关度+新旧合并后打包）
# PUBMED_YES_RETRIEVE_CANDIDATES=500
# PUBMED_YES_RERANK_TOP_N=100
# PUBMED_YES_UNIQUE_PAPERS=100
# PUBMED_YES_PACK_CHARS=48000
# REF_FOOTER_MIN=20
# REF_FOOTER_MAX=25
# GPU1_BURN=0
# BLAST：NCBI RefSeq GRCz12tu CDS/RNA。缺库时不要静默改用 GRCz11。
# BLAST_FASTA=/path/to/runtime/blast/grcz12tu_cds.fna
# BLAST_DB_DIR=
# BLAST_ALLOW_GRCZ11_FALLBACK=0
# NCBI_REFERENCE_ASSEMBLY=GRCz12tu
# NCBI_REFERENCE_REFSEQ=GCF_049306965.1
# REFERENCE_ASSEMBLY=GRCz11
# FAISS_PUBMED_YES_DIR=  # Hub 文献 v2_merged 分片目录
# BLAST_BIN=./tools/blast+/bin
# PUBMED_YES_RERANK=1
# GPU 分卡：Hub 主嵌入 cuda:0；PubmedYes 问句嵌入 + 重排 cuda:1
# EMBEDDING_DEVICE=cuda:0
# PUBMED_EMBEDDING_DEVICE=cuda:1
# BGE_RERANKER_DEVICE=cuda:1

# ---- 服务器部署凭据（示例：真实值放 .env，勿写入源码）----
ZF_HOST=your.server.host
ZF_PORT=22
ZF_USER=your_user
ZF_PASS=your_password
ZF_BASE=/path/to/project
ZF_RUNTIME=/path/to/runtime

# ---- 共享服务器省资源档（可选；不设即保持原有“启动就预热”行为）----
# HUB_WARMUP_RAG=0              启动只加载 0.5B 轻量模型，4B 嵌入+知识库索引改为首次访问按需加载
# HUB_PUBMED_WARMUP=0           不预热文献分片（默认即 0）
# PUBMED_YES_SHARD_RESERVE_MB=6000   装不下的分片不装，返回体带 partial（默认 4000）
# EMBEDDING_DEVICE=cpu          显式锁 CPU；共享机器上不要抢别人的显存
# 另：由 hub_supervise.sh 启动时会 export CUDA_VISIBLE_DEVICES=（空），把 GPU 完全隐藏

# ── 多机并行问答（并发闸，2026-10-30 实测后放宽）──────────────
# CHAT_MAX_CONCURRENCY=4        同时进行的问答条数（默认 4；实测单次峰值仅 +60MB，32 核很闲）
#                               远程 API 被限流或内存吃紧时下调；加机器只改这一个数
# CHAT_QUEUE_WAIT_SEC=900       单问最长排队等待（超时返回 503 提示，不再无限悬挂）
# CHAT_QUEUE_MAX=64             队列最大长度（超出返回 429）
# CHAT_LLM_CONCURRENCY=         推理并发；留空=自适应（云端推理取全局并发）
